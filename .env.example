# ==============================================================================
# OMNIS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# Never commit actual credentials or private keys to version control.
# ==============================================================================

# Application Identity & Public URLs
NEXT_PUBLIC_APP_NAME="OMNIS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Python FastAPI Backend Service URL (Optional in serverless mode; used when running standalone FastAPI)
FASTAPI_BACKEND_URL="http://127.0.0.1:8000"

# Database Configuration (PostgreSQL with pgvector in production; SQLite fallback in local dev/CI)
DATABASE_URL="postgresql+psycopg://omnis_user:password@localhost:5432/omnis_db"

# Redis Caching & Rate Limiting (Optional in local dev; falls back to bounded in-memory TTL cache)
REDIS_URL="redis://localhost:6379/0"

# Authentication & Session Security
OMNIS_AUTH_SECRET="replace-with-cryptographically-random-64-char-hex-secret"
SESSION_MAX_AGE_SECONDS="604800"

# External Data Providers (Public APIs work out-of-the-box; optional keys raise rate limits)
OPENALEX_POLITE_EMAIL="research@omnis-intelligence.org"
NASA_API_KEY="DEMO_KEY"
WORLD_BANK_API_BASE="https://api.worldbank.org/v2"
REST_COUNTRIES_API_BASE="https://restcountries.com/v3.1"
WIKIMEDIA_API_BASE="https://en.wikipedia.org/api/rest_v1"

# Optional AI Provider Key (For extended LLM synthesis; deterministic citation-backed synthesis always active)
AI_PROVIDER_API_KEY=""
